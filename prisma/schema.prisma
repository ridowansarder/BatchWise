

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Batch {
  id        String   @id @default(cuid())
  name      String
  capacity  Int?
  
  orgId     String
  students  Student[]
  teacherId String?  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@unique([name, orgId])
}
enum Gender {
  MALE
  FEMALE
  OTHER
}

model Student {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  address     String?
  dateOfBirth DateTime?
  gender      Gender?
  
  orgId       String
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id])
  attendance  Attendance[]
  fees        Fee[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@index([batchId])
  @@unique([email, orgId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id        String           @id @default(cuid())
  date      DateTime    @db.Date     
  status    AttendanceStatus @default(PRESENT)
  
  orgId     String           
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy  String?          

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([studentId])
  @@index([date])
  @@unique([studentId, date]) 
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

model Fee {
  id          String    @id @default(cuid())
  amount      Decimal   @db.Decimal(10, 2)
  description String?   
  dueDate     DateTime
  paidDate    DateTime?
  status      FeeStatus @default(PENDING)
  
  orgId       String
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId])
  @@index([studentId])
}